{% endif %}
{% if "locate_files" in tools %}
- Prefer `locate_files` over `find`/`rg --files` for names and globs.
{% endif %}
{% if "list_dir" in tools %}
- Prefer `list_dir` over `ls` for directory listings.
{% endif %}
